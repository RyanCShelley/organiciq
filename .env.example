# Copy to .env / apps/web/.env.local for local login.
# For Railway + Vercel production values, see the Production section below and README → Deploy.

# Shared
# Local development only. Production values must be unique and 32+ bytes; the
# API refuses to boot with APP_ENV=production while these defaults are in place.
APP_ENV=development
AUTH_SECRET=dev-auth-secret-change-me
# Authenticates the web app to POST /auth/upsert. Unset locally = check skipped.
INTERNAL_API_SECRET=

# Web (Auth.js) — login only (prefer a separate GCP OAuth Web client from data OAuth)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Must match the host you open in the browser. Prefer 127.0.0.1 (not localhost).
AUTH_URL=http://127.0.0.1:3000
NEXTAUTH_URL=http://127.0.0.1:3000
AUTH_TRUST_HOST=true
# Google Cloud → Credentials → this client → Authorized redirect URIs:
#   http://127.0.0.1:3000/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
# Authorized JavaScript origins:
#   http://127.0.0.1:3000
#   http://localhost:3000
API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
SMA_GOOGLE_HOSTED_DOMAIN=smamarketing.net

# API
DATABASE_URL=postgresql+psycopg://organiciq:organiciq@localhost:5432/organiciq
SMA_ADMIN_EMAILS=admin@smamarketing.net
INTEGRATION_TOKEN_KEY=dev-integration-token-key-32bytes!!
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
WEB_APP_URL=http://127.0.0.1:3000

# Google Data OAuth (GSC + GA4 — separate from login client)
GOOGLE_DATA_OAUTH_CLIENT_ID=
GOOGLE_DATA_OAUTH_CLIENT_SECRET=
GOOGLE_DATA_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/oauth/google/callback

# SE Ranking (Phase 4 Search / Phase 5 AI)
SE_RANKING_API_KEY=

# Decision Engine (Phase 9)
DECISION_ENGINE_ENABLED=true

# Daily auto-sync (worker / embedded worker)
DAILY_SYNC_ENABLED=true
DAILY_SYNC_HOUR_UTC=11
DAILY_SYNC_LOOKBACK_DAYS=3

# =============================================================================
# Production — Railway (Postgres + API + worker) + Vercel (web)
# =============================================================================
# Replace <vercel-host> and <railway-api-host> after first deploy (*.vercel.app /
# *.up.railway.app is fine for v1). AUTH_SECRET and INTEGRATION_TOKEN_KEY must be
# strong and identical across services where noted.
#
# Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The API refuses to start with APP_ENV=production if AUTH_SECRET,
# INTEGRATION_TOKEN_KEY or INTERNAL_API_SECRET is missing, short, or still the
# development default.
#
# --- Vercel (apps/web, Root Directory = apps/web) ---
# AUTH_SECRET=<same as Railway API>
# INTERNAL_API_SECRET=<same as Railway API — authenticates POST /auth/upsert>
# AUTH_GOOGLE_ID=<login OAuth client id>
# AUTH_GOOGLE_SECRET=<login OAuth client secret>
# AUTH_URL=https://<vercel-host>
# NEXTAUTH_URL=https://<vercel-host>
# AUTH_TRUST_HOST=true
# API_URL=https://<railway-api-host>
# NEXT_PUBLIC_API_URL=https://<railway-api-host>
# SMA_GOOGLE_HOSTED_DOMAIN=smamarketing.net
#
# --- Railway API + worker (shared, except start command) ---
# APP_ENV=production
# DATABASE_URL=<from Railway Postgres plugin; postgresql:// is auto-normalized to +psycopg>
# AUTH_SECRET=<same as Vercel — forges admin JWTs if leaked or left default>
# INTEGRATION_TOKEN_KEY=<stable 32+ byte secret; decrypts stored Google refresh tokens>
# INTERNAL_API_SECRET=<same as Vercel>
# SMA_ADMIN_EMAILS=admin@smamarketing.net,you@smamarketing.net
# SMA_GOOGLE_HOSTED_DOMAIN=smamarketing.net
# ALLOWED_ORIGINS=https://<vercel-host>
# WEB_APP_URL=https://<vercel-host>
# GOOGLE_DATA_OAUTH_CLIENT_ID=<data OAuth client id>
# GOOGLE_DATA_OAUTH_CLIENT_SECRET=<data OAuth client secret>
# GOOGLE_DATA_OAUTH_REDIRECT_URI=https://<railway-api-host>/oauth/google/callback
# SE_RANKING_API_KEY=<se ranking api key>
# DECISION_ENGINE_ENABLED=true
# WORKER_POLL_INTERVAL_SECONDS=2
# DAILY_SYNC_ENABLED=true
# DAILY_SYNC_HOUR_UTC=11
# DAILY_SYNC_LOOKBACK_DAYS=3
#
# Google Cloud redirect URIs (production):
#   Login client:  https://<vercel-host>/api/auth/callback/google
#   Login origins: https://<vercel-host>
#   Data client:   https://<railway-api-host>/oauth/google/callback
